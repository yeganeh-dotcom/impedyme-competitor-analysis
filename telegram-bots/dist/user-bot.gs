}

function liClaimCaption_(c, post) {
  var head = liTypeIcon_(c.Type) + " <b>" + liTypeFa_(c.Type) + " برای بررسی</b>";
  var t = head + "\n👤 " + esc_(c.Name) + " (ID: <code>" + esc_(c.UID) + "</code>)\n" +
