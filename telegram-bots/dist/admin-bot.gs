  USERS: "👥 آمار و لیست کاربران",
  SYNC: "🔄 بروزرسانی سکه‌ها",
  COINS: "🪙 مدیریت سکه کاربر",
  MSG_ONE: "✉️ پیام به یک کاربر",
  WITHDRAWALS: "💳 درخواستهای تسویه",
  CHECK: "🔍 بررسی کاربر",
  PUSH_MENU: "📲 ارسال منوی جدید به همه",
