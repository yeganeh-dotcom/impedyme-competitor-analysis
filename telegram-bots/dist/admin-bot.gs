/**
 * ADMIN BOT = Config + Core + AdminBot + AdminViews
 * Generated by build.sh from the files in shared/ and admin-bot/ - edit those, then rebuild.
 * HOW TO INSTALL: delete ALL old code files in this Apps Script project, paste this whole file,
 * fill SHEET_ID / USER_BOT_TOKEN / ADMIN_BOT_TOKEN in CONFIG below, then
 * Deploy > Manage deployments > Edit (pencil) > Version: New version > Deploy  (keeps the same URL).
 */

/**
 * ============================================================
 *  Config.gs  —  این فایل باید در «هر دو» پروژه (ربات کاربر و ربات ادمین)
 *  دقیقاً یکسان باشد.
 * ============================================================
 *
 *  مقادیر زیر را با اطلاعات خودتان پر کنید.
 *  (اختیاری و امن‌تر) می‌توانید هر کدام از این کلیدها را در
 *  Project Settings → Script Properties با همین نام ذخیره کنید؛
 *  در آن صورت مقدار Script Properties بر مقدار این فایل اولویت دارد
 *  و دیگر لازم نیست توکن داخل کد باشد.
 */
var CONFIG = {
  SHEET_ID: "PUT_YOUR_SPREADSHEET_ID_HERE",
  USER_BOT_TOKEN: "PUT_USER_BOT_TOKEN_HERE",
  ADMIN_BOT_TOKEN: "PUT_ADMIN_BOT_TOKEN_HERE",

  // منطقه زمانی ثابت برای محاسبه سقف ساعتی (در هر دو پروژه یکسان می‌ماند)
  TIMEZONE: "Asia/Tehran",

  // قوانین سکه (فقط اینجا عوض کنید تا هر دو ربات یکسان حساب کنند)
  COIN_VALUE_TOMAN: 5000,
  MIN_WITHDRAW_TOMAN: 300000,
  PAGEVIEWS_PER_COIN: 20,
  HEARTBEATS_PER_COIN: 15,
  HOURLY_LIMIT_PER_PAGE: 5,

  SITE_URL: "https://www.impedyme.com/",

  // ویدیوهای راهنما
  MOBILE_VIDEO_LINK: "https://drive.google.com/file/d/1j5E1EQpSxzMeFqqel631ynWrAUId-hSz/view?usp=drive_link",
  DESKTOP_VIDEO_LINK: "https://drive.google.com/file/d/1g19HjjOOZhgtjedNc987dP20h8_iLwYX/view?usp=drive_link",

  // شناسه‌های تلگرام ادمین‌ها (اختیاری). اگر خالی باشد و در شیت Settings هم
  // چیزی ثبت نشده باشد، اولین نفری که به ربات ادمین /start بدهد ادمین می‌شود.
  ADMIN_IDS: ""
};

function cfg_(key) {
  try {
    var v = PropertiesService.getScriptProperties().getProperty(key);
    if (v !== null && v !== "") return v;
  } catch (e) {}
  return CONFIG[key];
}

/**
 * ============================================================
 *  Core.gs  —  منطق مشترک سکه‌ها، کاربران، کلمات و تسویه
 *  ⚠️ این فایل باید در «هر دو» پروژه (ربات کاربر و ربات ادمین) دقیقاً یکسان باشد.
 *  هر وقت تغییرش دادید، در هر دو پروژه جایگزین کنید و CORE_VERSION را بالا ببرید.
 *  ربات ادمین در «⚙️ وضعیت سیستم» اختلاف نسخه را هشدار می‌دهد.
 * ============================================================
 *
 *  ایده اصلی (رفع مشکل کم شدن سکه‌ها):
 *  - هر ردیف لاگ فقط «یک بار» داوری می‌شود و نتیجه‌اش در ستون Credit همان
 *    تب کاربر ذخیره می‌شود (COUNTED / LIMIT / NO_KEYWORD / ...).
 *  - شمارنده‌های تجمعی (CountedPV, CountedHB) و نشانگر ProcessedRows در شیت Users
 *    ذخیره می‌شوند؛ یعنی سکه‌ها «بانکی» هستند و دیگر از صفر حساب نمی‌شوند.
 *  - کلمات کلیدی حذف نمی‌شوند، فقط RemovedAt می‌گیرند؛ هر بازدید با کلماتی
 *    سنجیده می‌شود که «در زمان همان بازدید» فعال بوده‌اند.
 *  نتیجه: عوض کردن کلمات یا آپدیت کد، هرگز سکه کسی را کم نمی‌کند.
 */
var CORE_VERSION = "v2.1.0";

var SHEETS = {
  USERS: "Users",
  KEYWORDS: "DailyKeywords",
  WITHDRAWALS: "Withdrawals",
  SETTINGS: "Settings",
  HISTORY: "CoinHistory"
};

var USER_HEADERS = ["ChatID", "UID", "Name", "Email", "EarnedCoins", "Adjustment", "TotalCoins", "LastUpdated",
  "CountedPV", "CountedHB", "ProcessedRows", "LegacyBonus", "LinkUid", "LogTab", "JoinedAt"];
var KW_HEADERS = ["Keyword", "URL", "AddedAt", "RemovedAt"];
var WD_HEADERS = ["ChatID", "UID", "Name", "Card", "Amount", "Date", "Status", "Coins", "RequestID", "ProcessedAt", "AdminNote"];
var HISTORY_HEADERS = ["Date", "Admin", "ChatID", "UID", "Name", "Action", "Delta", "NewAdjustment", "BalanceAfter", "Note"];
var SETTINGS_HEADERS = ["Key", "Value"];

// ستون‌های قدیمی (اگر عنوان ستون‌ها دستی عوض شده باشد، از جایگاه قدیمی استفاده می‌شود)
var LEGACY_POSITIONS = {
  Users: ["ChatID", "UID", "Name", "Email", "EarnedCoins", "Adjustment", "TotalCoins", "LastUpdated"],
  Withdrawals: ["ChatID", "UID", "Name", "Card", "Amount", "Date", "Status"],
  DailyKeywords: ["Keyword", "URL"]
};

// ستون‌های تب لاگ هر کاربر (۱ تا ۱۳ را اسکریپت شیت می‌نویسد، ۱۵ و ۱۶ را ربات)
var LOG = { TIME: 1, EVENT: 4, PAGE: 6, REF: 7, COUNTRY: 10, TZ: 11, TRAFFIC: 13, CREDIT: 15, CREDIT_KW: 16 };
var LOG_WIDTH = 16;
var CAP_LOOKBACK_ROWS = 600;

var ST = {
  COUNTED: "COUNTED", LIMIT: "LIMIT", NO_KEYWORD: "NO_KEYWORD", NOT_GOOGLE: "NOT_GOOGLE",
  SPONSORED: "SPONSORED", IRAN: "IRAN", OTHER: "OTHER"
};

var WD_STATUS = { PENDING: "Pending", PAID: "Paid", REJECTED: "Rejected" };

/* ------------------------- ابزارهای عمومی ------------------------- */

function num_(v) { var n = Number(v); return isFinite(n) ? n : 0; }
function isBlank_(v) { return v === "" || v === null || v === undefined; }
function isDate_(v) { return Object.prototype.toString.call(v) === "[object Date]" && !isNaN(v.getTime()); }

function toMs_(v) {
  if (isDate_(v)) return v.getTime();
  if (isBlank_(v) || typeof v === "number") return null;
  var t = Date.parse(String(v).trim());
  return isNaN(t) ? null : t;
}

function toEnDigits_(s) {
  return String(s === null || s === undefined ? "" : s)
    .replace(/[۰-۹]/g, function (d) { return String(d.charCodeAt(0) - 0x06F0); })
    .replace(/[٠-٩]/g, function (d) { return String(d.charCodeAt(0) - 0x0660); });
}

function esc_(t) {
  if (t === null || t === undefined) return "";
  return String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

function fmtNum_(n) {
  var v = Math.round(num_(n));
  var s = String(Math.abs(v)).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
  return (v < 0 ? "-" : "") + s;
}

function signed_(n) { n = num_(n); return (n > 0 ? "+" : "") + n; }

function tz_() { return cfg_("TIMEZONE") || "Asia/Tehran"; }

function fmtDate_(v, pattern) {
  var ms = toMs_(v);
  if (ms === null) return "—";
  return Utilities.formatDate(new Date(ms), tz_(), pattern || "yyyy-MM-dd HH:mm");
}

function cleanPath_(u) {
  if (!u) return "";
  var p = String(u).toLowerCase().trim();
  p = p.replace(/^https?:\/\/[^\/]+/, "");
  p = p.split("?")[0].split("#")[0];
  return p.replace(/^\/+|\/+$/g, "");
}

function cleanName_(name) { return String(name || "").toLowerCase().replace(/\s+/g, ""); }

// باید دقیقاً با userTabName_ در اسکریپت شیت (لاگر) یکی باشد
function userTabName_(linkUid) {
  var safe = String(linkUid).replace(/[\/\?\*\[\]:]/g, "-").trim();
  return ("User - " + safe).substring(0, 100);
}

function personalLink_(linkUid) {
  return String(cfg_("SITE_URL")) + "?uid=" + encodeURIComponent(linkUid);
}

function coinValue_() { return num_(cfg_("COIN_VALUE_TOMAN")) || 5000; }

function withLock_(fn) {
  var lock = LockService.getScriptLock();
  try { lock.waitLock(20000); } catch (e) {
    throw new Error("سیستم مشغول است، چند ثانیه دیگر دوباره تلاش کنید.");
  }
  try { return fn(); } finally { try { lock.releaseLock(); } catch (e2) {} }
}

/* ------------------------- دسترسی به شیت ------------------------- */

var _ssCache = null;
var _colCache = {};
var _settingsCache = null;

function ss_() {
  if (!_ssCache) _ssCache = SpreadsheetApp.openById(cfg_("SHEET_ID"));
  return _ssCache;
}

function sheet_(name, headers) {
  var ss = ss_();
  var sh = ss.getSheetByName(name);
  if (!sh) sh = ss.insertSheet(name);
  if (headers) colMap_(sh, headers);
  return sh;
}

function ensureColumns_(sh, n) {
  var max = sh.getMaxColumns();
  if (max < n) sh.insertColumnsAfter(max, n - max);
}

/** نقشه «نام ستون ← شماره ستون»؛ ستون‌های جاافتاده را به انتهای سطر عنوان اضافه می‌کند. */
function colMap_(sh, headers) {
  var key = sh.getName();
  if (_colCache[key]) return _colCache[key];
  var lastCol = sh.getLastColumn();
  var names = lastCol > 0 ? sh.getRange(1, 1, 1, lastCol).getValues()[0].map(function (h) { return String(h).trim(); }) : [];
  while (names.length && names[names.length - 1] === "") names.pop();
  var map = {};
  names.forEach(function (h, i) { if (h && !map[h]) map[h] = i + 1; });
  (LEGACY_POSITIONS[key] || []).forEach(function (h, i) { if (!map[h] && names[i]) map[h] = i + 1; });
  var missing = (headers || []).filter(function (h) { return !map[h]; });
  if (missing.length) {
    var start = names.length + 1;
    ensureColumns_(sh, start + missing.length - 1);
    sh.getRange(1, start, 1, missing.length).setValues([missing]).setFontWeight("bold");
    missing.forEach(function (h, i) { map[h] = start + i; });
    if (names.length === 0) sh.setFrozenRows(1);
  }
  _colCache[key] = map;
  return map;
}

/** چند سلول از یک ردیف را می‌نویسد؛ ستون‌های کنار هم را در یک فراخوانی می‌نویسد. */
function writeCells_(sh, row, map, obj) {
  var cols = Object.keys(obj).map(function (k) {
    if (!map[k]) throw new Error("ستون " + k + " پیدا نشد");
    return { c: map[k], v: obj[k] };
  }).sort(function (a, b) { return a.c - b.c; });
  var i = 0;
  while (i < cols.length) {
    var j = i;
    while (j + 1 < cols.length && cols[j + 1].c === cols[j].c + 1) j++;
    var vals = [];
    for (var k = i; k <= j; k++) vals.push(cols[k].v);
    sh.getRange(row, cols[i].c, 1, vals.length).setValues([vals]);
    i = j + 1;
  }
}

/* ------------------------- تنظیمات (شیت Settings) ------------------------- */

function settings_() {
  if (_settingsCache) return _settingsCache;
  var sh = sheet_(SHEETS.SETTINGS, SETTINGS_HEADERS);
  var last = sh.getLastRow();
  var map = {};
  if (last >= 2) {
    sh.getRange(2, 1, last - 1, 2).getValues().forEach(function (r, i) {
      var k = String(r[0]).trim();
      if (k) map[k] = { row: i + 2, value: r[1] };
    });
  }
  _settingsCache = map;
  return map;
}

function getSetting_(key) { var s = settings_()[key]; return s ? s.value : ""; }

function setSetting_(key, value) {
  var s = settings_();
  var sh = sheet_(SHEETS.SETTINGS, SETTINGS_HEADERS);
  if (s[key]) {
    sh.getRange(s[key].row, 2).setValue(value);
    s[key].value = value;
  } else {
    sh.appendRow([key, value]);
    s[key] = { row: sh.getLastRow(), value: value };
  }
}

function adminIds_() {
  var raw = String(getSetting_("ADMIN_IDS") || "") + "," + String(cfg_("ADMIN_IDS") || "");
  return raw.split(/[,\s'"]+/).map(function (x) { return toEnDigits_(x).trim(); })
    .filter(function (x) { return /^-?\d+$/.test(x); });
}

/** زمان مهاجرت به نسخه جدید (برای بازسازی دقیق سکه‌های قبلی) */
function migrationMs_() {
  var ms = toMs_(getSetting_("MIGRATION_TIME"));
  if (ms === null) {
    ms = Date.now();
    setSetting_("MIGRATION_TIME", new Date(ms));
  }
  return ms;
}

/** جلوگیری از پردازش دوباره یک پیام وقتی تلگرام آپدیت را دوباره می‌فرستد */
function isDuplicateUpdate_(update, prefix) {
  if (!update || update.update_id === undefined) return false;
  var cache = CacheService.getScriptCache();
  var key = prefix + "_upd_" + update.update_id;
  if (cache.get(key)) return true;
  cache.put(key, "1", 21600);
  return false;
}

/** هر ربات نسخه Core خودش را در Settings ثبت می‌کند تا اختلاف نسخه معلوم شود */
function reportCoreVersion_(botKey) {
  try {
    var cache = CacheService.getScriptCache();
    var ck = "corever_" + botKey + "_" + CORE_VERSION;
    if (cache.get(ck)) return;
    var key = "CORE_VERSION_" + botKey;
    if (String(getSetting_(key)) !== CORE_VERSION) setSetting_(key, CORE_VERSION);
    cache.put(ck, "1", 21600);
  } catch (e) {}
}

function maxCol_(map) { var m = 0; for (var k in map) if (map[k] > m) m = map[k]; return m; }

function blankRow_(map) { var a = []; for (var i = 0; i < maxCol_(map); i++) a.push(""); return a; }

/* ------------------------- کاربران ------------------------- */

function usersSheet_() {
  var sh = sheet_(SHEETS.USERS, USER_HEADERS);
  return { sh: sh, map: colMap_(sh, USER_HEADERS) };
}

function rowToUser_(r, map, rowIndex) {
  function g(h) { return map[h] ? r[map[h] - 1] : ""; }
  var name = String(g("Name")).trim();
  var uid = String(g("UID")).trim();
  var linkUid = String(g("LinkUid")).trim() || (cleanName_(name) + uid);
  var processedRaw = g("ProcessedRows");
  return {
    row: rowIndex,
    chatId: String(g("ChatID")).trim(),
    uid: uid,
    name: name,
    email: String(g("Email")).trim(),
    earned: num_(g("EarnedCoins")),
    adj: num_(g("Adjustment")),
    total: num_(g("TotalCoins")),
    updated: g("LastUpdated"),
    pv: num_(g("CountedPV")),
    hb: num_(g("CountedHB")),
    processed: isBlank_(processedRaw) ? null : num_(processedRaw),
    bonus: num_(g("LegacyBonus")),
    linkUid: linkUid,
    logTab: String(g("LogTab")).trim() || userTabName_(linkUid),
    joined: g("JoinedAt")
  };
}

function readAllUsers_() {
  var u = usersSheet_();
  var last = u.sh.getLastRow();
  var width = Math.max(u.sh.getLastColumn(), maxCol_(u.map));
  var vals = last >= 2 ? u.sh.getRange(2, 1, last - 1, width).getValues() : [];
  var users = [];
  vals.forEach(function (r, i) {
    var x = rowToUser_(r, u.map, i + 2);
    if (x.chatId || x.uid) users.push(x);
  });
  return { sh: u.sh, map: u.map, vals: vals, width: width, users: users };
}

function findUserByChatId_(chatId) {
  var u = usersSheet_();
  var last = u.sh.getLastRow();
  if (last < 2) return null;
  var target = String(chatId).trim();
  var ids = u.sh.getRange(2, u.map.ChatID, last - 1, 1).getValues();
  for (var i = 0; i < ids.length; i++) {
    if (String(ids[i][0]).trim() === target) {
      var width = Math.max(u.sh.getLastColumn(), maxCol_(u.map));
      return rowToUser_(u.sh.getRange(i + 2, 1, 1, width).getValues()[0], u.map, i + 2);
    }
  }
  return null;
}

/** جستجوی کاربر برای ادمین: اول تطابق دقیق (UID / ChatID / نام / ایمیل)، بعد تطابق جزئی */
function findUsers_(query) {
  var q = toEnDigits_(query).trim().toLowerCase().replace(/^@/, "");
  if (!q) return [];
  var all = readAllUsers_().users;
  var exact = all.filter(function (u) {
    return u.uid.toLowerCase() === q || u.chatId === q || u.linkUid.toLowerCase() === q ||
      u.name.toLowerCase() === q || u.email.toLowerCase() === q;
  });
  if (exact.length) return exact;
  return all.filter(function (u) {
    return u.name.toLowerCase().indexOf(q) !== -1 || u.email.toLowerCase().indexOf(q) !== -1 ||
      u.linkUid.toLowerCase().indexOf(q) !== -1 || u.uid.indexOf(q) !== -1;
  }).slice(0, 15);
}

/** ثبت‌نام: اگر کاربر قبلاً ثبت شده باشد، هویت و لینکش «هرگز» عوض نمی‌شود */
function registerUser_(chatId, name, email) {
  return withLock_(function () {
    var existing = findUserByChatId_(chatId);
    if (existing) return { user: existing, created: false };
    var u = usersSheet_();
    var last = u.sh.getLastRow();
    var used = {};
    if (last >= 2) {
      u.sh.getRange(2, u.map.UID, last - 1, 1).getValues().forEach(function (r) { used[String(r[0]).trim()] = true; });
    }
    var uid;
    do { uid = String(Math.floor(100000 + Math.random() * 900000)); } while (used[uid]);
    var linkUid = cleanName_(name) + uid;
    var logTab = userTabName_(linkUid);
    var oldTab = ss_().getSheetByName(logTab);
    var now = new Date();
    var row = blankRow_(u.map);
    var vals = {
      ChatID: String(chatId), UID: uid, Name: name, Email: email, EarnedCoins: 0, Adjustment: 0, TotalCoins: 0,
      LastUpdated: now, CountedPV: 0, CountedHB: 0, ProcessedRows: oldTab ? Math.max(1, oldTab.getLastRow()) : 1,
      LegacyBonus: 0, LinkUid: linkUid, LogTab: logTab, JoinedAt: now
    };
    Object.keys(vals).forEach(function (k) { row[u.map[k] - 1] = vals[k]; });
    u.sh.appendRow(row);
    return { user: findUserByChatId_(chatId), created: true };
  });
}

/* ------------------------- کلمات کلیدی (با تاریخچه) ------------------------- */

function keywordsSheet_() {
  var sh = sheet_(SHEETS.KEYWORDS, KW_HEADERS);
  return { sh: sh, map: colMap_(sh, KW_HEADERS) };
}

/** همه کلمات (فعال و حذف‌شده) با بازه زمانی فعال بودنشان */
function getKeywordHistory_() {
  var k = keywordsSheet_();
  var last = k.sh.getLastRow();
  var list = [];
  if (last < 2) return list;
  k.sh.getRange(2, 1, last - 1, maxCol_(k.map)).getValues().forEach(function (r, i) {
    var kw = String(r[k.map.Keyword - 1]).trim();
    if (!kw) return;
    var from = toMs_(r[k.map.AddedAt - 1]);
    var to = toMs_(r[k.map.RemovedAt - 1]);
    list.push({
      row: i + 2, kw: kw, url: String(r[k.map.URL - 1] || "").trim(),
      from: from === null ? -Infinity : from, to: to === null ? Infinity : to
    });
  });
  return list;
}

function activeAt_(list, ms) { return list.filter(function (k) { return k.from <= ms && ms < k.to; }); }
function activeKeywords_() { return activeAt_(getKeywordHistory_(), Date.now()); }

/** هر خط: «کلمه, لینک». کلمه تکراری با لینک جدید، جایگزین قبلی می‌شود. */
function addKeywords_(text) {
  var k = keywordsSheet_();
  var now = new Date();
  var active = activeKeywords_();
  var res = { added: 0, updated: 0, skipped: 0 };
  String(text).split(/\r?\n/).forEach(function (line) {
    line = line.trim();
    if (!line) return;
    var idx = line.search(/[,،|\t]/);
    var kw = (idx === -1 ? line : line.substring(0, idx)).trim();
    var url = (idx === -1 ? "" : line.substring(idx + 1)).trim();
    if (!kw) return;
    var same = active.filter(function (a) { return a.kw.toLowerCase() === kw.toLowerCase(); });
    if (same.some(function (a) { return a.url === url; })) { res.skipped++; return; }
    same.forEach(function (a) { k.sh.getRange(a.row, k.map.RemovedAt).setValue(now); });
    if (same.length) res.updated++; else res.added++;
    var row = blankRow_(k.map);
    row[k.map.Keyword - 1] = kw;
    row[k.map.URL - 1] = url;
    row[k.map.AddedAt - 1] = now;
    k.sh.appendRow(row);
  });
  return res;
}

/** حذف نرم: فقط RemovedAt ثبت می‌شود تا بازدیدهای قبلی همچنان معتبر بمانند.
 *  target: نام کلمه، شماره ردیف در لیست (مثلاً 2 یا 1,3)، یا ALL */
function removeKeywords_(target) {
  var t = toEnDigits_(target).trim();
  var all = t.toUpperCase() === "ALL" || t === "همه";
  var nums = /^[\d\s,،]+$/.test(t) ? t.split(/[\s,،]+/).filter(String).map(Number) : [];
  var k = keywordsSheet_();
  var now = new Date();
  var removed = [];
  activeKeywords_().forEach(function (a, i) {
    if (all || nums.indexOf(i + 1) !== -1 || a.kw.toLowerCase() === t.toLowerCase()) {
      k.sh.getRange(a.row, k.map.RemovedAt).setValue(now);
      removed.push(a.kw);
    }
  });
  return removed;
}

/* ------------------------- داوری هر بازدید ------------------------- */

function isSponsoredVisit_(pagePath, referrer) {
  var p = String(pagePath || "").toLowerCase();
  var r = String(referrer || "").toLowerCase();
  if (/(gclid=|gad_source=|gbraid=|wbraid=|_gl=)/.test(p)) return true;
  if (/(utm_medium=cpc|utm_medium=paid|utm_source=google_ads|utm_source=adwords)/.test(p)) return true;
  if (/(\/aclk|googleads|doubleclick|adservice\.google)/.test(r)) return true;
  if (p.indexOf("/aclk") !== -1) return true;
  return false;
}

/** legacy=true یعنی دقیقاً همان قانون نسخه قدیمی (فقط برای بازسازی سکه‌های قبلی) */
function keywordMatch_(k, rawPage, legacy) {
  var page = cleanPath_(rawPage);
  var target = cleanPath_(k.url);
  var kw = String(k.kw).toLowerCase().trim();
  var slug = kw.replace(/\s+/g, "-");
  var normKw = kw.replace(/[\s\-_]+/g, "");
  var normPage = page.replace(/[\s\-_]+/g, "");
  if (legacy) {
    if (target && (page === target || page.indexOf(target) !== -1 || target.indexOf(page) !== -1)) return true;
    if (slug && page.indexOf(slug) !== -1) return true;
    if (normKw && (normPage.indexOf(normKw) !== -1 || normKw.indexOf(normPage) !== -1)) return true;
    return false;
  }
  // نسخه جدید: صفحه اصلی (مسیر خالی) دیگر با «هر» کلمه‌ای جور درنمی‌آید
  if (String(k.url || "").trim()) {
    if (!target) { if (!page) return true; }
    else if (page === target || page.indexOf(target) !== -1 || (page && target.indexOf(page) !== -1)) return true;
  }
  if (!page) return false;
  if (slug && page.indexOf(slug) !== -1) return true;
  if (normKw && normPage && (normPage.indexOf(normKw) !== -1 || normKw.indexOf(normPage) !== -1)) return true;
  return false;
}

function capBucket_(ms, legacy) {
  return Utilities.formatDate(new Date(ms), tz_(), legacy ? "H" : "yyyyMMddHH");
}

/** وضعیت یک ردیف لاگ؛ opts: {legacy, fixedKeywords, ignoreKeywords} */
function judgeRow_(r, kwHistory, opts) {
  opts = opts || {};
  var ev = String(r[LOG.EVENT - 1] || "").toLowerCase().trim();
  var country = String(r[LOG.COUNTRY - 1] || "").toLowerCase();
  var tz = String(r[LOG.TZ - 1] || "").trim();
  if (tz === "Asia/Tehran" || country.indexOf("iran") !== -1) return { status: ST.IRAN };
  var page = String(r[LOG.PAGE - 1] || "");
  var ref = String(r[LOG.REF - 1] || "");
  if (ev.indexOf("sponsored") !== -1 || String(r[LOG.TRAFFIC - 1] || "").toUpperCase() === "SPONSORED_AD" ||
    isSponsoredVisit_(page, ref)) return { status: ST.SPONSORED };
  if (ev !== "pageview" && ev !== "heartbeat") return { status: ST.OTHER };
  if (ref.toLowerCase().indexOf("google") === -1) return { status: ST.NOT_GOOGLE };
  var ms = toMs_(r[LOG.TIME - 1]);
  if (ms === null) return { status: ST.OTHER };
  var hit = null;
  if (opts.ignoreKeywords) {
    hit = { kw: "*" };
  } else {
    var list = opts.fixedKeywords || activeAt_(kwHistory, ms);
    for (var i = 0; i < list.length && !hit; i++) if (keywordMatch_(list[i], page, !!opts.legacy)) hit = list[i];
  }
  if (!hit) return { status: ST.NO_KEYWORD };
  return { status: ST.COUNTED, ev: ev, kw: hit.kw, key: capBucket_(ms, !!opts.legacy) + "_" + cleanPath_(page) + "_" + ev };
}

function capKeyOf_(r) {
  var ms = toMs_(r[LOG.TIME - 1]);
  if (ms === null) return null;
  return capBucket_(ms, false) + "_" + cleanPath_(r[LOG.PAGE - 1]) + "_" + String(r[LOG.EVENT - 1] || "").toLowerCase().trim();
}

function hourlyLimit_() { return num_(cfg_("HOURLY_LIMIT_PER_PAGE")) || 5; }

/** شمارش کامل یک مجموعه ردیف (برای بازسازی سکه‌های قبلی و تخمین) */
function countRows_(rows, kwHistory, opts) {
  var caps = {}, pv = 0, hb = 0, limit = hourlyLimit_();
  rows.forEach(function (r) {
    var j = judgeRow_(r, kwHistory, opts);
    if (j.status !== ST.COUNTED) return;
    var c = caps[j.key] || 0;
    if (c >= limit) return;
    caps[j.key] = c + 1;
    if (j.ev === "pageview") pv++; else hb++;
  });
  return { pv: pv, hb: hb };
}

function coinsFrom_(pv, hb) {
  return Math.floor(pv / (num_(cfg_("PAGEVIEWS_PER_COIN")) || 20)) +
    Math.floor(hb / (num_(cfg_("HEARTBEATS_PER_COIN")) || 15));
}

/* ------------------------- دفتر سکه (Ledger) ------------------------- */

function makeCtx_() {
  return { kwHistory: getKeywordHistory_(), migrationMs: migrationMs_(), sheets: null };
}

function logSheetOf_(user, ctx) {
  if (ctx && ctx.sheets) return ctx.sheets[user.logTab] || null;
  return ss_().getSheetByName(user.logTab);
}

/** مهاجرت یک‌باره: موجودی فعلی کاربر را «قفل» می‌کند تا آپدیت کد چیزی را کم نکند */
function migrateUser_(user, ctx) {
  var tab = logSheetOf_(user, ctx);
  var last = tab ? tab.getLastRow() : 1;
  var pv = 0, hb = 0;
  var legacyKws = activeAt_(ctx.kwHistory, ctx.migrationMs);
  if (tab && last >= 2 && legacyKws.length) {
    var c = countRows_(tab.getRange(2, 1, last - 1, 13).getValues(), null, { legacy: true, fixedKeywords: legacyKws });
    pv = c.pv; hb = c.hb;
  }
  user.pv = pv;
  user.hb = hb;
  user.bonus = Math.max(0, user.earned - coinsFrom_(pv, hb)); // هیچ‌کس کمتر از عدد قبلی‌اش نمی‌گیرد
  user.processed = Math.max(1, last);
  user.migrated = true;
}

/** فقط ردیف‌های جدید لاگ را داوری می‌کند و به شمارنده‌ها اضافه می‌کند (هرگز کم نمی‌کند) */
function settleUser_(user, ctx) {
  if (user.processed === null) migrateUser_(user, ctx);
  var tab = logSheetOf_(user, ctx);
  if (!tab) return user;
  var last = tab.getLastRow();
  if (last < user.processed) { user.processed = Math.max(1, last); return user; }
  if (last === user.processed) return user;
  ensureColumns_(tab, LOG_WIDTH);
  var limit = hourlyLimit_();
  var start = Math.max(2, user.processed + 1 - CAP_LOOKBACK_ROWS);
  var data = tab.getRange(start, 1, last - start + 1, LOG_WIDTH).getValues();
  var caps = {}, out = [], addPv = 0, addHb = 0;
  for (var i = 0; i < data.length; i++) {
    var r = data[i];
    if (start + i <= user.processed) {
      if (String(r[LOG.CREDIT - 1]) === ST.COUNTED) {
        var key = capKeyOf_(r);
        if (key) caps[key] = (caps[key] || 0) + 1;
      }
      continue;
    }
    var j = judgeRow_(r, ctx.kwHistory, {});
    var status = j.status;
    if (status === ST.COUNTED) {
      var c = caps[j.key] || 0;
      if (c >= limit) status = ST.LIMIT;
      else { caps[j.key] = c + 1; if (j.ev === "pageview") addPv++; else addHb++; }
    }
    out.push([status, j.kw || ""]);
  }
  if (String(tab.getRange(1, LOG.CREDIT).getValue()) === "") {
    tab.getRange(1, LOG.CREDIT, 1, 2).setValues([["Credit", "Credit Keyword"]]).setFontWeight("bold");
  }
  tab.getRange(user.processed + 1, LOG.CREDIT, out.length, 2).setValues(out);
  user.pv += addPv;
  user.hb += addHb;
  user.processed = last;
  return user;
}

/** فرمول واحد موجودی؛ هر دو ربات فقط از همین استفاده می‌کنند */
function balanceOf_(user, wt) {
  wt = wt || { pending: 0, paid: 0, pendingCount: 0 };
  var activity = coinsFrom_(user.pv, user.hb) + user.bonus;
  var raw = activity + user.adj - wt.pending - wt.paid;
  var coins = Math.max(0, raw);
  return {
    activity: activity, adj: user.adj, pending: wt.pending, paid: wt.paid, pendingCount: wt.pendingCount || 0,
    raw: raw, coins: coins, toman: coins * coinValue_()
  };
}

function saveLedger_(user, b) {
  var u = usersSheet_();
  writeCells_(u.sh, user.row, u.map, {
    EarnedCoins: b.activity, TotalCoins: b.coins, LastUpdated: new Date(),
    CountedPV: user.pv, CountedHB: user.hb, ProcessedRows: user.processed,
    LegacyBonus: user.bonus, LinkUid: user.linkUid, LogTab: user.logTab
  });
}

/** موجودی دقیق و به‌روز یک کاربر (همان چیزی که کاربر در کیف پول می‌بیند) */
function getFreshBalance_(user) {
  settleUser_(user, makeCtx_());
  user.wt = withdrawalTotals_(readWithdrawals_().list)[user.chatId];
  var b = balanceOf_(user, user.wt);
  saveLedger_(user, b);
  return b;
}

/** به‌روزرسانی همه کاربران (ادمین/تریگر). فقط ستون‌های دفتر سکه نوشته می‌شوند، نه Adjustment. */
function settleAllUsers_() {
  var all = readAllUsers_();
  var ctx = makeCtx_();
  ctx.sheets = {};
  ss_().getSheets().forEach(function (s) { ctx.sheets[s.getName()] = s; });
  var wt = withdrawalTotals_(readWithdrawals_().list);
  var res = { users: all.users, wt: wt, errors: 0, migrated: 0, bonusUsers: [] };
  var now = new Date();
  var map = all.map;
  all.users.forEach(function (u) {
    var wasNew = u.processed === null;
    try {
      settleUser_(u, ctx);
      if (wasNew) { res.migrated++; if (u.bonus > 0) res.bonusUsers.push(u); }
    } catch (e) { res.errors++; }
    u.balance = balanceOf_(u, wt[u.chatId]);
    var r = all.vals[u.row - 2];
    r[map.EarnedCoins - 1] = u.balance.activity;
    r[map.TotalCoins - 1] = u.balance.coins;
    r[map.LastUpdated - 1] = now;
    r[map.CountedPV - 1] = u.pv;
    r[map.CountedHB - 1] = u.hb;
    r[map.ProcessedRows - 1] = u.processed === null ? "" : u.processed;
    r[map.LegacyBonus - 1] = u.bonus;
    r[map.LinkUid - 1] = u.linkUid;
    r[map.LogTab - 1] = u.logTab;
  });
  if (all.vals.length) {
    var cols = ["EarnedCoins", "TotalCoins", "LastUpdated", "CountedPV", "CountedHB", "ProcessedRows", "LegacyBonus", "LinkUid", "LogTab"]
      .map(function (h) { return map[h]; }).sort(function (a, b) { return a - b; });
    var i = 0;
    while (i < cols.length) {
      var j = i;
      while (j + 1 < cols.length && cols[j + 1] === cols[j] + 1) j++;
      var c1 = cols[i], c2 = cols[j];
      all.sh.getRange(2, c1, all.vals.length, c2 - c1 + 1)
        .setValues(all.vals.map(function (r) { return r.slice(c1 - 1, c2); }));
      i = j + 1;
    }
  }
  setSetting_("LAST_SETTLE_ALL", now);
  return res;
}

/** خلاصه وضعیت ردیف‌های لاگ یک کاربر (برای «🔍 بررسی کاربر») */
function creditBreakdown_(user) {
  var tab = ss_().getSheetByName(user.logTab);
  if (!tab || tab.getLastRow() < 2) return null;
  var last = tab.getLastRow();
  ensureColumns_(tab, LOG_WIDTH);
  var data = tab.getRange(2, 1, last - 1, LOG_WIDTH).getValues();
  var counts = {};
  data.forEach(function (r) {
    var s = String(r[LOG.CREDIT - 1]).trim() || "BEFORE_UPDATE";
    counts[s] = (counts[s] || 0) + 1;
  });
  var est = countRows_(data, null, { ignoreKeywords: true });
  return { rows: last - 1, counts: counts, lastTime: data[data.length - 1][LOG.TIME - 1], estimateAllGoogle: coinsFrom_(est.pv, est.hb) };
}

/* ------------------------- تسویه حساب ------------------------- */

function wdSheet_() {
  var sh = sheet_(SHEETS.WITHDRAWALS, WD_HEADERS);
  return { sh: sh, map: colMap_(sh, WD_HEADERS) };
}

function normalizeWdStatus_(s) {
  s = String(s || "").trim();
  if (!s || /pend|انتظار/i.test(s)) return WD_STATUS.PENDING;
  if (/paid|done|پرداخت|واریز|^ok$|✅/i.test(s)) return WD_STATUS.PAID;
  if (/reject|cancel|رد|لغو/i.test(s)) return WD_STATUS.REJECTED;
  return s;
}

function readWithdrawals_() {
  var w = wdSheet_();
  var last = w.sh.getLastRow();
  var list = [];
  if (last >= 2) {
    w.sh.getRange(2, 1, last - 1, maxCol_(w.map)).getValues().forEach(function (r, i) {
      function g(h) { return r[w.map[h] - 1]; }
      var chatId = String(g("ChatID")).trim();
      if (!chatId && !String(g("Card")).trim() && !String(g("Amount")).trim()) return;
      var rid = String(g("RequestID")).trim();
      list.push({
        row: i + 2, chatId: chatId, uid: String(g("UID")).trim(), name: String(g("Name")).trim(),
        card: String(g("Card")).trim(), amount: g("Amount"), date: g("Date"),
        status: normalizeWdStatus_(g("Status")), coins: isBlank_(g("Coins")) ? null : num_(g("Coins")),
        id: rid || ("R" + (i + 2)), hasId: !!rid, processedAt: g("ProcessedAt"),
        note: String(g("AdminNote") || "").trim()
      });
    });
  }
  return { sh: w.sh, map: w.map, list: list };
}

/** «در انتظار» و «پرداخت‌شده» از موجودی کم می‌شوند؛ «ردشده» خودبه‌خود برمی‌گردد */
function withdrawalTotals_(list) {
  var m = {};
  list.forEach(function (w) {
    var t = m[w.chatId] || (m[w.chatId] = { pending: 0, paid: 0, pendingCount: 0, pendingReq: null });
    if (w.status === WD_STATUS.PENDING) {
      t.pending += w.coins || 0;
      t.pendingCount++;
      if (!t.pendingReq) t.pendingReq = w;
    } else if (w.status === WD_STATUS.PAID) {
      t.paid += w.coins || 0;
    }
  });
  return m;
}

function parseAmountCoins_(amount) {
  var n = num_(toEnDigits_(amount).replace(/[^\d]/g, ""));
  return Math.round(n / coinValue_());
}

function formatCard_(digits) { return String(digits).replace(/(\d{4})(?=\d)/g, "$1-"); }

function luhnOk_(digits) {
  var sum = 0, dbl = false;
  for (var i = digits.length - 1; i >= 0; i--) {
    var d = Number(digits.charAt(i));
    if (dbl) { d *= 2; if (d > 9) d -= 9; }
    sum += d;
    dbl = !dbl;
  }
  return sum % 10 === 0;
}

/** ثبت درخواست تسویه؛ سکه‌ها همان لحظه رزرو (کسر) می‌شوند تا درخواست تکراری ممکن نباشد */
function createWithdrawal_(user, cardDigits) {
  return withLock_(function () {
    var w = readWithdrawals_();
    var t = withdrawalTotals_(w.list)[user.chatId];
    if (t && t.pendingCount > 0) return { ok: false, reason: "pending", req: t.pendingReq };
    var b = getFreshBalance_(user);
    if (b.toman < num_(cfg_("MIN_WITHDRAW_TOMAN"))) return { ok: false, reason: "min", b: b };
    var id = "W" + Utilities.formatDate(new Date(), tz_(), "yyMMddHHmmss") + Math.floor(10 + Math.random() * 90);
    var row = blankRow_(w.map);
    var vals = {
      ChatID: user.chatId, UID: user.uid, Name: user.name, Card: formatCard_(cardDigits),
      Amount: fmtNum_(b.toman) + " تومان", Date: new Date(), Status: WD_STATUS.PENDING, Coins: b.coins, RequestID: id
    };
    Object.keys(vals).forEach(function (k) { row[w.map[k] - 1] = vals[k]; });
    w.sh.appendRow(row);
    var b2 = balanceOf_(user, { pending: b.pending + b.coins, paid: b.paid, pendingCount: 1 });
    var u = usersSheet_();
    writeCells_(u.sh, user.row, u.map, { TotalCoins: b2.coins, LastUpdated: new Date() });
    return { ok: true, id: id, coins: b.coins, toman: b.toman, card: formatCard_(cardDigits) };
  });
}

function findWithdrawal_(reqId) {
  var list = readWithdrawals_().list;
  for (var i = 0; i < list.length; i++) if (list[i].id === reqId) return list[i];
  return null;
}

/**
 * action: "paid" (پرداخت شد؛ سکه‌های رزروشده برای همیشه کسر می‌مانند)
 *       | "paid0" (درخواست قدیمی که قبلاً دستی کسر شده)
 *       | "reject" (رد؛ سکه‌ها به موجودی کاربر برمی‌گردند)
 * note: شماره پیگیری واریز یا دلیل رد (اختیاری) که برای کاربر هم ارسال می‌شود
 */
function processWithdrawal_(adminId, reqId, action, note) {
  return withLock_(function () {
    var w = readWithdrawals_();
    var req = null;
    for (var i = 0; i < w.list.length; i++) if (w.list[i].id === reqId) req = w.list[i];
    if (!req) return { ok: false, reason: "notfound" };
    if (req.status !== WD_STATUS.PENDING) return { ok: false, reason: "already", req: req };
    var upd = {
      Status: action === "reject" ? WD_STATUS.REJECTED : WD_STATUS.PAID,
      ProcessedAt: new Date()
    };
    if (!req.hasId) upd.RequestID = req.id;
    if (action === "paid" && req.coins === null) upd.Coins = parseAmountCoins_(req.amount);
    if (action === "paid0") upd.Coins = 0;
    if (note) upd.AdminNote = "'" + note;
    writeCells_(w.sh, req.row, w.map, upd);
    req.status = upd.Status;
    req.processedAt = upd.ProcessedAt;
    req.note = note || req.note;
    if (upd.Coins !== undefined) req.coins = upd.Coins;
    var user = findUserByChatId_(req.chatId);
    var balance = null;
    if (user) {
      balance = getFreshBalance_(user);
      logHistory_(adminId, user, "withdraw_" + action, 0, user.adj, balance.coins, reqId + (note ? " | " + note : ""));
    }
    return { ok: true, req: req, user: user, balance: balance };
  });
}

/* ------------------------- تغییر دستی سکه توسط ادمین ------------------------- */

function logHistory_(adminId, user, action, delta, newAdj, balanceAfter, note) {
  try {
    var sh = sheet_(SHEETS.HISTORY, HISTORY_HEADERS);
    sh.appendRow([new Date(), String(adminId), user.chatId, user.uid, user.name, action, delta, newAdj, balanceAfter, note || ""]);
  } catch (e) {}
}

/** op: add | sub | set | zero  — همیشه روی موجودی «تازه» اعمال می‌شود */
function adminAdjust_(adminId, chatId, op, amount, note) {
  return withLock_(function () {
    var user = findUserByChatId_(chatId);
    if (!user) throw new Error("کاربر پیدا نشد.");
    var before = getFreshBalance_(user);
    var delta = 0;
    if (op === "add") delta = amount;
    else if (op === "sub") delta = -Math.min(amount, Math.max(0, before.raw));
    else if (op === "set") delta = amount - before.raw;
    else if (op === "zero") delta = -before.raw;
    user.adj = user.adj + delta;
    var after = balanceOf_(user, user.wt);
    var u = usersSheet_();
    writeCells_(u.sh, user.row, u.map, { Adjustment: user.adj, TotalCoins: after.coins, LastUpdated: new Date() });
    logHistory_(adminId, user, op, delta, user.adj, after.coins, note);
    return { user: user, before: before, after: after, delta: delta, requested: amount };
  });
}

/** ریست کامل: لاگ‌های کاربر پاک و موجودی صفر می‌شود (سابقه تسویه‌ها حفظ می‌شود) */
function adminFullReset_(adminId, chatId) {
  return withLock_(function () {
    var user = findUserByChatId_(chatId);
    if (!user) throw new Error("کاربر پیدا نشد.");
    var tab = ss_().getSheetByName(user.logTab);
    var cleared = 0;
    if (tab && tab.getLastRow() > 1) {
      cleared = tab.getLastRow() - 1;
      tab.getRange(2, 1, cleared, tab.getLastColumn()).clearContent();
    }
    var t = withdrawalTotals_(readWithdrawals_().list)[user.chatId] || { pending: 0, paid: 0 };
    user.pv = 0; user.hb = 0; user.bonus = 0; user.processed = 1;
    user.adj = t.pending + t.paid;
    var u = usersSheet_();
    writeCells_(u.sh, user.row, u.map, {
      EarnedCoins: 0, Adjustment: user.adj, TotalCoins: 0, LastUpdated: new Date(), CountedPV: 0, CountedHB: 0,
      ProcessedRows: 1, LegacyBonus: 0, LinkUid: user.linkUid, LogTab: user.logTab
    });
    logHistory_(adminId, user, "full_reset", 0, user.adj, 0, "cleared " + cleared + " log rows");
    return { user: user, cleared: cleared };
  });
}

/* ------------------------- تلگرام ------------------------- */

function tgApi_(token, method, payload) {
  try {
    var resp = UrlFetchApp.fetch("https://api.telegram.org/bot" + token + "/" + method, {
      method: "post", contentType: "application/json", payload: JSON.stringify(payload), muteHttpExceptions: true
    });
    try { return JSON.parse(resp.getContentText()); }
    catch (e) { return { ok: false, description: "HTTP " + resp.getResponseCode() }; }
  } catch (e2) {
    return { ok: false, description: String(e2) };
  }
}

function stripHtml_(t) {
  return String(t).replace(/<[^>]+>/g, "").replace(/&lt;/g, "<").replace(/&gt;/g, ">")
    .replace(/&quot;/g, '"').replace(/&amp;/g, "&");
}

function splitText_(text, maxLen) {
  if (text.length <= maxLen) return [text];
  var chunks = [], cur = "";
  text.split("\n").forEach(function (line) {
    while (line.length > maxLen) { if (cur) { chunks.push(cur); cur = ""; } chunks.push(line.substring(0, maxLen)); line = line.substring(maxLen); }
    if ((cur + "\n" + line).length > maxLen) { if (cur) chunks.push(cur); cur = line; }
    else cur = cur ? cur + "\n" + line : line;
  });
  if (cur) chunks.push(cur);
  return chunks;
}

/** ارسال HTML؛ اگر تلگرام قالب را نپذیرفت، همان متن ساده ارسال می‌شود (پیام گم نمی‌شود) */
function tgSend_(token, chatId, text, markup) {
  var chunks = splitText_(String(text || "—"), 3800);
  var res = null;
  for (var i = 0; i < chunks.length; i++) {
    var p = { chat_id: chatId, text: chunks[i], parse_mode: "HTML", link_preview_options: { is_disabled: true } };
    if (markup && i === chunks.length - 1) p.reply_markup = markup;
    res = tgApi_(token, "sendMessage", p);
    if (!res.ok && /parse|entit|tag|url/i.test(res.description || "")) {
      delete p.parse_mode;
      p.text = stripHtml_(chunks[i]);
      res = tgApi_(token, "sendMessage", p);
    }
    if (chunks.length > 1) Utilities.sleep(250);
  }
  return res;
}

function tgEdit_(token, chatId, messageId, text, inlineMarkup) {
  var p = { chat_id: chatId, message_id: messageId, text: text, parse_mode: "HTML", link_preview_options: { is_disabled: true } };
  if (inlineMarkup) p.reply_markup = inlineMarkup;
  var res = tgApi_(token, "editMessageText", p);
  if (!res.ok && !/not modified/i.test(res.description || "")) res = tgSend_(token, chatId, text, inlineMarkup);
  return res;
}

function tgAnswerCb_(token, cbId, text, alert) {
  return tgApi_(token, "answerCallbackQuery", { callback_query_id: cbId, text: text || "", show_alert: !!alert });
}

/** ارسال گروهی سریع (۲۵ پیام در هر دسته) */
function tgBroadcast_(token, chatIds, text, markup) {
  var res = { sent: 0, failed: 0, blocked: 0 };
  for (var i = 0; i < chatIds.length; i += 25) {
    var reqs = chatIds.slice(i, i + 25).map(function (id) {
      var p = { chat_id: id, text: text, parse_mode: "HTML", link_preview_options: { is_disabled: true } };
      if (markup) p.reply_markup = markup;
      return {
        url: "https://api.telegram.org/bot" + token + "/sendMessage", method: "post",
        contentType: "application/json", payload: JSON.stringify(p), muteHttpExceptions: true
      };
    });
    UrlFetchApp.fetchAll(reqs).forEach(function (r) {
      var code = r.getResponseCode();
      if (code === 200) res.sent++; else if (code === 403) res.blocked++; else res.failed++;
    });
    if (i + 25 < chatIds.length) Utilities.sleep(1100);
  }
  return res;
}

function tokenOk_(t) { return !!t && !/^PUT_/.test(String(t)); }

function notifyAdmins_(text, inlineMarkup) {
  var token = cfg_("ADMIN_BOT_TOKEN");
  if (!tokenOk_(token)) return;
  adminIds_().forEach(function (id) { tgSend_(token, id, text, inlineMarkup); });
}

function notifyUser_(chatId, text) {
  var token = cfg_("USER_BOT_TOKEN");
  if (!tokenOk_(token) || !chatId) return { ok: false };
  return tgSend_(token, chatId, text, userMainKeyboard_());
}

