    {
      "@type": "Product",
      "@id": "https://impedyme.com/motor-emulator/#product",
      "name": "Impedyme Motor Emulator",
      "alternateName": "Impedyme Motor Emulation Platform",
      "url": "https://impedyme.com/motor-emulator/",
      "mainEntityOfPage": { "@id": "https://impedyme.com/motor-emulator/#webpage" },
      "description": "The Impedyme Motor Emulator is an active, programmable motor emulation platform for developing and validating inverter hardware for electrified mobility. Engineers start with low-power, signal-level testing of unmodified controller hardware on the Real-Time Control Prototyping (RCP) box, then scale to power-level validation under real-world voltage and current with the CHP motor emulator, all on one unified platform. Unlike passive R-L loads, which apply only reactive power and cannot return power to the inverter's DC side, the motor emulator's four-quadrant operation enables active power testing under true-to-life conditions, so components such as diodes and switches are stressed realistically. It helps teams accelerate inverter development, increase testing precision and bring electric mobility products to market faster.",
      "category": "Test & Measurement > Hardware-in-the-Loop (HIL) Test Systems > Motor Emulators",
      "brand": { "@id": "https://impedyme.com/#brand" },
      "manufacturer": { "@id": "https://impedyme.com/#organization" },
      "image": [
        { "@id": "https://impedyme.com/motor-emulator/#primaryimage" },
        { "@id": "https://impedyme.com/motor-emulator/#image-fpga-hil" },
        { "@id": "https://impedyme.com/motor-emulator/#image-rcp-box" }
      ],
      "audience": {
        "@type": "BusinessAudience",
        "audienceType": "Engineers developing and validating inverter hardware for electrified mobility and electric drivetrains"
      },
      "additionalProperty": [
        { "@type": "PropertyValue", "name": "Testing levels", "value": "Signal level (RCP box) and power level (CHP system) on one unified motor emulation platform" },
        { "@type": "PropertyValue", "name": "Operating mode", "value": "Four-quadrant operation for full torque/speed range and active power testing under true-to-life conditions" },
        { "@type": "PropertyValue", "name": "UUT commissioning", "value": "Only four parameters need to be defined to start testing" },
        { "@type": "PropertyValue", "name": "Live parameter adjustment", "value": "Parameters such as R and L can be changed with a mouse click during operation" },
        { "@type": "PropertyValue", "name": "Facility power connection", "value": 5, "unitCode": "KWT", "unitText": "kW AC" },
        { "@type": "PropertyValue", "name": "Cooling", "value": "Stand-alone liquid cooling; no facility water connection or external chiller required" },
        { "@type": "PropertyValue", "name": "Real-time simulation", "value": "Ultra-fast, high-fidelity HIL powered by FPGA technology" },
        { "@type": "PropertyValue", "name": "Device under test", "value": "Unmodified controller hardware (signal level) and inverter hardware (power level)" },
        { "@type": "PropertyValue", "name": "Advantage over passive R-L loads", "value": "Emulates realistic active power and power flow, while passive R-L loads apply only reactive power and cannot return power to the inverter's DC side" },
        { "@type": "PropertyValue", "name": "Development phases", "value": "All R&D phases, from concept to production, with full traceability" },
        { "@type": "PropertyValue", "name": "Applications", "value": "Inverter hardware development and validation for electrified mobility and modern electric drivetrains" }
      ],
      "isRelatedTo": [
        {
          "@type": "Product",
          "@id": "https://impedyme.com/motor-emulator/#chp-motor-emulator",
          "name": "Impedyme CHP Motor Emulator",
          "description": "Active, programmable power-level motor emulator for inverter hardware testing. It delivers functional validation under real-world voltage and current conditions, providing a more realistic and detailed testing environment than conventional inductive (passive R-L) setups for modern electric drivetrains.",
          "category": "Power-level motor emulator",
          "brand": { "@id": "https://impedyme.com/#brand" },
          "manufacturer": { "@id": "https://impedyme.com/#organization" }
        },
        {
          "@type": "Product",
          "@id": "https://impedyme.com/motor-emulator/#rcp-box",
          "name": "Impedyme RCP Box",
          "alternateName": "Impedyme Real-Time Control Prototyping (RCP) Box",
          "description": "Low-power, signal-level motor emulation for early-stage inverter development, when uncertainty is high. The RCP box lets engineers test unmodified controller hardware against high-fidelity real-time simulation without risking physical components.",
          "category": "Signal-level motor emulator / Real-Time Control Prototyping (RCP)",
          "image": { "@id": "https://impedyme.com/motor-emulator/#image-rcp-box" },
          "brand": { "@id": "https://impedyme.com/#brand" },
          "manufacturer": { "@id": "https://impedyme.com/#organization" }
        }
      ],
      "subjectOf": { "@id": "https://impedyme.com/motor-emulator/#faq" }
    },
    {
      "@type": "FAQPage",
      "@id": "https://impedyme.com/motor-emulator/#faq",
      "isPartOf": { "@id": "https://impedyme.com/motor-emulator/#webpage" },
      "about": { "@id": "https://impedyme.com/motor-emulator/#product" },
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Can the Impedyme motor emulator be used for both low and high-power testing?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. The Impedyme motor emulator supports both signal-level testing—using the Real-Time Control Prototyping (RCP) box—and high-power hardware emulation with the CHP system. This flexible architecture allows engineers to streamline development from concept to production, using one unified motor emulation platform."
          }
        }
      ]
    },
