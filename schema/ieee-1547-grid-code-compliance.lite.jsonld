    {
      "@type": "ItemList",
      "@id": "https://impedyme.com/resource-center/ieee-1547-grid-code-compliance-testing/#test-categories",
      "name": "The four categories of IEEE 1547.1 conformance test",
      "description": "The conformance programme is not a single event. It is four distinct activities, applied at different points in a product's life.",
      "numberOfItems": 4,
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "subjectOf": {
        "@id": "https://impedyme.com/resource-center/ieee-1547-grid-code-compliance-testing/#article"
      },
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Type tests",
          "item": {
            "@type": "Thing",
            "name": "Type tests",
            "description": "Happens once per product design. Covers the full behavioural programme against the requirements standard. Runs in a laboratory, on a conformance bench."
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Production tests",
          "item": {
            "@type": "Thing",
            "name": "Production tests",
            "description": "Happens for every unit shipped. Covers abbreviated checks on abnormal voltage and frequency response, plus documentation. Runs at the factory, end of line."
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Commissioning tests and evaluations",
          "item": {
            "@type": "Thing",
            "name": "Commissioning tests and evaluations",
            "description": "Happens per installation. Verifies that the installed system behaves correctly at its point of connection. Runs on site."
          }
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Periodic tests",
          "item": {
            "@type": "Thing",
            "name": "Periodic tests",
            "description": "Happens at intervals over service life. Confirms that protective behaviour has not drifted. Runs on site."
          }
        }
      ]
    },
    {
      "@type": "ItemList",
      "@id": "https://impedyme.com/resource-center/ieee-1547-grid-code-compliance-testing/#regional-frameworks",
      "name": "Grid code compliance frameworks by region",
      "description": "Comparable obligations exist in every major market and converge on the same functional families — ride-through, grid support, anti-islanding, power quality — while differing in thresholds, category structures, and how compliance is verified.",
      "numberOfItems": 5,
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "subjectOf": {
        "@id": "https://impedyme.com/resource-center/ieee-1547-grid-code-compliance-testing/#article"
      },
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "North America",
          "item": {
            "@type": "Thing",
            "name": "North America",
            "description": "Governing framework: the requirements standard plus its conformance test procedures companion. Verification: a single prescriptive test-procedure document feeding a laboratory certification."
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "European Union",
          "item": {
            "@type": "Thing",
            "name": "European Union",
            "description": "Governing framework: the harmonised network code for generators, implemented through European connection standards for low- and medium-voltage generating plant. Verification: the framework mandates that compliance be verified but leaves procedures largely to member states."
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Germany",
          "item": {
            "@type": "Thing",
            "name": "Germany",
            "description": "Governing framework: national application rules for low, medium, and high voltage connection. Verification: a certificate-based scheme with separate national test and modelling guidelines."
          }
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "United Kingdom",
          "item": {
            "@type": "Thing",
            "name": "United Kingdom",
            "description": "Governing framework: engineering recommendations for small and larger generating units. Verification: type-test evidence assessed against the recommendation."
          }
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "Australia / New Zealand",
          "item": {
            "@type": "Thing",
            "name": "Australia / New Zealand",
            "description": "Governing framework: the national inverter requirements standard with region-based setpoints. Verification: an approved-inverter listing maintained by the market body."
          }
        }
      ]
    },
    {
      "@type": "ItemList",
      "@id": "https://impedyme.com/resource-center/ieee-1547-grid-code-compliance-testing/#bench-functions",
      "name": "The four functions of a grid code compliance bench",
      "description": "Strip away the specifics and a conformance bench performs four functions. These are the same on any bench anywhere in the world; what differs is how many separate instruments are needed to deliver them.",
      "numberOfItems": 4,
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "subjectOf": {
        "@id": "https://impedyme.com/resource-center/ieee-1547-grid-code-compliance-testing/#article"
      },
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Drive the terminal",
          "item": {
            "@type": "Thing",
            "name": "Drive the terminal",
            "description": "Produce a controlled alternating-current condition at the equipment's grid connection — voltage, frequency, phase angle, and balance, each independently commandable."
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Supply the input",
          "item": {
            "@type": "Thing",
            "name": "Supply the input",
            "description": "Provide the direct-current source that the equipment under test converts."
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Measure the response",
          "item": {
            "@type": "Thing",
            "name": "Measure the response",
            "description": "Capture terminal voltage and output current with the bandwidth and accuracy the procedures require."
          }
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Execute the procedure",
          "item": {
            "@type": "Thing",
            "name": "Execute the procedure",
            "description": "Sequence the run, hold each condition for its required dwell, repeat it across settings, and retain the record."
          }
        }
      ]
    },
    {
      "@type": "ItemList",
      "@id": "https://impedyme.com/resource-center/ieee-1547-grid-code-compliance-testing/#source-capabilities",
      "name": "Capabilities the type tests demand of the source",
      "description": "Reading the type-test programme as a specification for the bench rather than for the product under test yields a clear list of requirements.",
      "numberOfItems": 7,
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "subjectOf": {
        "@id": "https://impedyme.com/resource-center/ieee-1547-grid-code-compliance-testing/#article"
      },
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Regenerative, bidirectional power flow",
          "item": {
            "@type": "Thing",
            "name": "Regenerative, bidirectional power flow",
            "description": "The equipment under test exports. The source must absorb that power continuously, not dissipate it, and must maintain the commanded condition while doing so."
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Independent per-phase control",
          "item": {
            "@type": "Thing",
            "name": "Independent per-phase control",
            "description": "Several tests require one phase to be driven while others are held, or phases to be driven in pairs. A source that can only move all three together cannot execute them."
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Phase-angle stepping",
          "item": {
            "@type": "Thing",
            "name": "Phase-angle stepping",
            "description": "Angle-change ride-through requires genuine, abrupt angle displacement, on one phase and on all three, repeatable at arbitrary points on the wave."
          }
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Step fidelity",
          "item": {
            "@type": "Thing",
            "name": "Step fidelity",
            "description": "A large number of procedures specify a step, not a ramp, precisely because a ramp makes the instant of crossing a matter of interpretation — and the measured clearing time with it."
          }
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "Low output distortion",
          "item": {
            "@type": "Thing",
            "name": "Low output distortion",
            "description": "Current distortion tests measure the equipment's contribution. A source that injects its own distortion contaminates the result."
          }
        },
        {
          "@type": "ListItem",
          "position": 6,
          "name": "Adequate stiffness relative to the device rating",
          "item": {
            "@type": "Thing",
            "name": "Adequate stiffness relative to the device rating",
            "description": "Whether a swell level can be held steady while the equipment under test reacts is a property of the source impedance relative to the device rating. This must be stated before coverage is claimed."
          }
        },
        {
          "@type": "ListItem",
          "position": 7,
          "name": "Measurement accuracy within the required class",
          "item": {
            "@type": "Thing",
            "name": "Measurement accuracy within the required class",
            "description": "The criteria are accuracy-bounded. A measurement path that cannot resolve the criterion cannot evidence it."
          }
        }
      ]
    },
    {
      "@type": "ItemList",
      "@id": "https://impedyme.com/resource-center/ieee-1547-grid-code-compliance-testing/#campaign-failure-modes",
      "name": "Why grid code compliance campaigns fail",
      "description": "Across the programme, failures cluster in a small number of places. Every item is discoverable in-house, before a laboratory campaign begins, on a bench that can execute the same procedures.",
      "numberOfItems": 6,
      "itemListOrder": "https://schema.org/ItemListOrderAscending",
      "subjectOf": {
        "@id": "https://impedyme.com/resource-center/ieee-1547-grid-code-compliance-testing/#article"
      },
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Ride-through behaviour under combined stress",
          "item": {
            "@type": "Thing",
            "name": "Ride-through behaviour under combined stress",
            "description": "Equipment that rides through a clean sag often fails a consecutive sequence, or fails when the sag is applied to a single phase rather than all three."
          }
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Settling and response times",
          "item": {
            "@type": "Thing",
            "name": "Settling and response times",
            "description": "The characteristic is met, but not within the declared response time — or the declared response time was optimistic in the datasheet and nobody re-checked it."
          }
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Priority conflicts",
          "item": {
            "@type": "Thing",
            "name": "Priority conflicts",
            "description": "Functions that behave correctly in isolation resolve in the wrong order when enabled together."
          }
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Setting ranges",
          "item": {
            "@type": "Thing",
            "name": "Setting ranges",
            "description": "The equipment meets the trip requirement at its default setting but its adjustable range does not span what the standard requires."
          }
        },
        {
          "@type": "ListItem",
          "position": 5,
          "name": "Bench limitations misread as device failures",
          "item": {
            "@type": "Thing",
            "name": "Bench limitations misread as device failures",
            "description": "A source too soft for the device rating cannot hold a swell; a measurement path outside the required accuracy class cannot evidence a criterion. Both produce results that look like device failures and are not."
          }
        },
        {
          "@type": "ListItem",
          "position": 6,
          "name": "Configuration drift",
          "item": {
            "@type": "Thing",
            "name": "Configuration drift",
            "description": "Firmware changes after testing, and the certified configuration no longer matches the shipped one."
          }
        }
      ]
    },
    {
      "@type": "Thing",
      "@id": "https://impedyme.com/#topic-grid-code-compliance",
      "name": "Grid code compliance testing",
      "description": "Proving under controlled and repeatable laboratory conditions that equipment behaves the way a network operator's grid code requires.",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Grid_code"
      ]
    },
    {
      "@type": "Thing",
      "@id": "https://impedyme.com/#topic-der",
      "name": "Distributed energy resource",
      "description": "A generating or storage resource connected to the distribution system, whose interconnection behaviour is governed by IEEE Std 1547.",
      "alternateName": "DER",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Distributed_generation"
      ]
    },
    {
      "@type": "Thing",
      "@id": "https://impedyme.com/#topic-phil",
      "name": "Power hardware-in-the-loop simulation",
      "description": "A test method that couples a real-time simulation model to real power hardware through an amplifier interface, used for pre-compliance and unintentional islanding testing.",
      "alternateName": "Power-HIL",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Hardware-in-the-loop_simulation"
      ]
    },
    {
      "@type": "Thing",
      "@id": "https://impedyme.com/#topic-hil",
      "name": "Hardware-in-the-loop simulation",
      "description": "Real-time simulation of a plant model against physical controller or power hardware under test.",
      "alternateName": "HIL",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Hardware-in-the-loop_simulation"
      ]
    },
    {
      "@type": "Thing",
      "@id": "https://impedyme.com/#topic-ride-through",
      "name": "Voltage and frequency ride-through",
      "description": "The requirement that a distributed energy resource stays connected and operating through voltage and frequency excursions rather than disconnecting."
    },
    {
      "@type": "Thing",
      "@id": "https://impedyme.com/#topic-islanding",
      "name": "Unintentional islanding",
      "description": "The condition in which a distributed energy resource continues to energize a section of network after it has been separated from the area electric power system.",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Islanding"
      ]
    },
    {
      "@type": "Thing",
      "@id": "https://impedyme.com/#topic-inverter",
      "name": "Grid-connected inverter",
      "description": "The power electronic converter that interfaces a distributed energy resource to the alternating-current network and is the subject of the type-test programme.",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Power_inverter"
      ]
    },
    {
      "@type": "Thing",
      "@id": "https://impedyme.com/#topic-power-quality",
      "name": "Power quality",
      "description": "Current distortion, direct-current injection and overvoltage contribution limits verified in the fifth family of the type-test programme.",
      "sameAs": [
        "https://en.wikipedia.org/wiki/Electric_power_quality"
      ]
    },
    {
      "@type": "Thing",
      "@id": "https://impedyme.com/#topic-grid-emulator",
      "name": "Regenerative grid emulator",
      "description": "A bidirectional alternating-current source that drives voltage, frequency, phase angle and balance at the terminal of equipment under test while absorbing its exported power."
    },
